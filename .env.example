# Copier ce fichier en `.env.local` (développement) ou définir ces variables chez l'hébergeur.
# `neon env pull` (ou `neon deploy`) écrit ces valeurs automatiquement dans .env.local.
# Ne jamais versionner les vraies valeurs : elles contiennent le mot de passe de la base.
# Dans une URL, les caractères spéciaux du mot de passe doivent être encodés : « @ » s'écrit « %40 ».

# PostgreSQL Neon — URL POOLÉE (hôte en « -pooler ») : utilisée par l'application.
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# PostgreSQL Neon — URL DIRECTE (sans « -pooler ») : migrations (drizzle-kit) et scripts db:*.
DATABASE_URL_UNPOOLED=postgresql://UTILISATEUR:MOT_DE_PASSE@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Branche Neon correspondante (information, écrite par `neon env pull`).
NEON_BRANCH=production

# Dashboard (adresse définie par ADMIN_PATH dans lib/site.ts, /ALLAH par défaut).
# Mot de passe unique de connexion. Vide = connexion impossible.
ADMIN_PASSWORD=
# Clé de signature des sessions : une valeur aléatoire longue, par exemple
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vide = dérivée du mot de passe (changer le mot de passe déconnecte alors tout le monde).
ADMIN_SESSION_SECRET=

# Cloudflare R2 — toutes les images du site (bucket velzaro-media).
# Clés d'API : Cloudflare → R2 → Manage API tokens (« Object Read & Write » limité au bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Adresse publique du bucket, sans « / » final : https://pub-….r2.dev, puis https://media.prestigea.shop.
# Seule ligne à changer pour passer au domaine personnalisé : la base ne stocke que des clés.
R2_PUBLIC_URL=
